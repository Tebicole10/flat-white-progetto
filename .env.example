# Flat White Progetto — variables de entorno
#
# Copiá este archivo a .env y pegá los valores del proyecto de Firebase.
# Dónde sacarlos: consola de Firebase → ⚙ Configuración del proyecto →
# "Tus apps" → app web → "Configuración del SDK" → objeto firebaseConfig.
#
# El .env está en .gitignore y no se commitea.
# Ojo: estas claves son públicas por diseño (viajan en el bundle del navegador).
# Lo que protege los datos son las Firestore Rules, no la apiKey.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
