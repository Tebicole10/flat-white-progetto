rules_version = '2';

// Acceso público de lectura y escritura, sin autenticación individual.
// Es el equivalente a las policies que tenía Supabase:
//   CREATE POLICY ... FOR ALL USING (true) WITH CHECK (true);
// Mismo modelo de siempre: quien tiene el link, entra y opera.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
